<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="64dp" android:background="@color/background" app:titleTextColor="@color/ink" />
    <TextView android:id="@+id/mode_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/demo_banner" android:gravity="center" android:padding="6dp" android:textSize="11sp" android:textColor="@color/teal" android:background="@color/mint" />
    <androidx.fragment.app.FragmentContainerView android:id="@+id/nav_host" android:name="androidx.navigation.fragment.NavHostFragment" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" app:defaultNavHost="true" app:navGraph="@navigation/main_nav" />
    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/bottom_nav" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/surface" app:menu="@menu/bottom_nav" app:labelVisibilityMode="labeled" app:itemIconTint="@color/nav_item" app:itemTextColor="@color/nav_item" />
</LinearLayout>
